{
  "name": "seven-habits-mentor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -k -n web,agent -c cyan,magenta \"npm run dev\" \"npm run agent\"",
    "agent": "tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "tsx scripts/verify-flows.ts",
    "verify:agent": "tsx scripts/verify-agent-api.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:all": "npm run lint && npm test && npm run verify && npm run verify:agent && npm run build"
  },
  "dependencies": {
    "@qoder-ai/qoder-agent-sdk": "^1.0.15",
    "date-fns": "^4.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "uuid": "^14.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
